{
  "name": "tsugikoko",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:auth": "firebase emulators:exec --only auth,firestore --project demo-tsugikoko \"E2E_AUTH_EMULATOR=1 playwright test\"",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test:extraction": "firebase emulators:exec --only auth,firestore --project demo-tsugikoko \"node --conditions=react-server --import tsx --test --test-concurrency=1 tests/integration/*.test.ts\"",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tsugikoko \"node --import tsx --test tests/rules/*.test.ts\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "firebase": "^13.0.0",
    "firebase-admin": "^14.5.0",
    "google-auth-library": "^11.3.1",
    "lucide-react": "^0.468.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.64.1",
    "@qiita/qiita-cli": "^1.10.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
